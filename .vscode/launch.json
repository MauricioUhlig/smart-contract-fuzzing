{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Confuzzius - Original",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/fuzzer/main.py",
            "console": "integratedTerminal",
            "args": [
                "--source", "${workspaceFolder}/${input:contractFile}",
                "-c", "${input:contractName}",
                "--solc", "v0.4.26",
                "--evm", "byzantium",
                "-g", "10",
                "--algorithm", "confuzzius",
                "--population-size", "40",
                "--probability-crossover", "0.8",
                "--probability-mutation", "0.35",
                "--data-dependency", "1"
            ]
        },
        {
            "name": "DivFuzz",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/fuzzer/main.py",
            "console": "integratedTerminal",
            "args": [
                "--source", "${workspaceFolder}/${input:contractFile}",
                "--contract", "${input:contractName}",
                "--algorithm", "divfuzz",
                "--generations", "20",
                "--population-size", "40",
                "--probability-crossover", "0.8",
                "--probability-mutation", "0.35",
                "--solc", "v0.8.30",
                "--evm", "byzantium",
                "-r", "${workspaceFolder}/results/divfuzz",
                "--seed", "0.813595275750147",
                "--max-symbolic-execution", "5",

                "--diversity", "1"
            ]
        },
        {
            "name": "Get contracts from folder",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/utils/solidity_parser.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/${input:folderToExtractContracts}",
                "--json",
                "--output", "${workspaceFolder}/${input:ouputFileToSaveExtractedContracts}"
            ]
        },
        {
            "name": "Batch runner",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/utils/batch_invoker.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/${input:ouputFileToSaveExtractedContracts}",
                "--algorithm", "divfuzz",
                "--generations", "20",
                "--population-size", "40",
                "--diversity-weight", "0.5",
                "--novelty-threshold", "0.6",
                "--probability-crossover", "0.8",
                "--probability-mutation", "0.35",
                "--solc", "v0.4.26",
                "--evm", "byzantium",

                "--diversity", "1"


            ]
        },
        {
            "name": "Parallel Batch runner",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/utils/parallel_batch_runner.py",
            "console": "integratedTerminal",
            "args": [
                "${workspaceFolder}/${input:ouputFileToSaveExtractedContracts}",
                "${workspaceFolder}/${input:basePathContractsToRun}",
                "--solc", "v0.4.26",
                "--evm", "byzantium",
                "-t", "600",

                // "--algorithm", "confuzzius",

                "--algorithm", "divfuzz",
                "--population-size", "100",
                "--probability-crossover", "0.9", // 0.9 e 0.5 cheguei em 92%
                "--probability-mutation", "0.20", // 0.2  cheguei em 92%
                "--data-dependency-weight", "0.6", // com 0.6, cheguei em 91.9%
                "--branch-weight", "1",
                "--unique-branch-weight", "2.0",
                "--diversity", "1"
            ]
        },
        {
            "name": "Vulnerability Report",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/utils/vulnerability_report.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Vulnerability Report - Simple",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/utils/vulnerability_report_simple.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Coverage Report",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/utils/report.py",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "contractFile",
            "type": "pickString",
            "description": "Select contract file:",
            "options": [
                "case-study/contracts/ContractA/WithdrawalVault.sol",
                "case-study/contracts/ContractB/WithdrawalVault.sol"
            ],
            "default": "case-study/contracts/ContractA/WithdrawalVault.sol"
        },
        {
            "id": "contractName",
            "type": "pickString",
            "description": "Enter the contract name:",
            "options": [
                "WithdrawalVault",
            ],
            "default": "RemiCoin"
        },
        { 
            "id": "folderToExtractContracts",
            "type": "promptString",
            "description": "Folder where to extract contracts:",
            "default": "examples",
        },
        { 
            "id": "ouputFileToSaveExtractedContracts",
            "type": "promptString",
            "description": "Folder where to extract contracts",
            "default": "utils/result-small.json",
        },
        { 
            "id": "basePathContractsToRun",
            "type": "promptString",
            "description": "Folder where to extract contracts",
            "default": "online-datasets/smartbugs-curated/dataset/",
        }
    ]
}